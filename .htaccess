Options -Indexes
RewriteEngine On

# URL pública /assets/... → archivos en app/public/assets/
# END evita que la regla siguiente vuelva a evaluar la ruta interna.
RewriteRule ^assets/(.*)$ app/public/assets/$1 [END]

# El código de app/ no se sirve por HTTP. Los estáticos ya se reescribieron arriba.
RewriteRule ^app/ - [F,L]
RewriteRule ^(librerias|tests)(/|$) - [F,L]

<FilesMatch "\.(env|md|sql|lock|zip|bak|phar|log|json)$">
    Require all denied
</FilesMatch>
